import pandas as pd

csv1 = "./datafinal/image_mapping_new.csv"
csv2 = "./datafinal2/image_mapping_new.csv"

df1 = pd.read_csv(csv1, low_memory=False)
df2 = pd.read_csv(csv2, low_memory=False)



# Replace backslashes with forward slashes
df1['image_filename'] = df1['image_filename'].str.replace("\\", "/", regex=False)
df2['image_filename'] = df2['image_filename'].str.replace("\\", "/", regex=False)

# Optional: if image_filename does not include full path, prepend directory
df1['image_filename'] = "datafinal/images/" + df1['image_filename'].apply(lambda x: x.split('/')[-1])
df2['image_filename'] = "datafinal2/images/" + df2['image_filename'].apply(lambda x: x.split('/')[-1])



df1.to_csv("./datafinal/image_mapping_fixed.csv", index=False)
df2.to_csv("./datafinal2/image_mapping_fixed.csv", index=False)



import os
df1['image_path'] = df1['image_filename'].apply(lambda x: os.path.join('datafinal/images', x))
df2['image_path'] = df2['image_filename'].apply(lambda x: os.path.join('datafinal2/images', x))



combined_df = pd.concat([df1, df2], ignore_index=True)
print("Combined dataset shape:", combined_df.shape)



combined_df = combined_df.sample(frac=1, random_state=42).reset_index(drop=True)




